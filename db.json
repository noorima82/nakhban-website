    "09903016541": [
      {
        "from": "user",
        "text": "سلام وقت بخیر",
        "at": "2026-11-26T08:24:12.379Z"
      },
      {
        "from": "user",
        "text": "میگم دوره برای مایی که کلاس یازدهم هستیم به درد میخوره؟",
        "at": "2026-11-26T08:24:42.683Z"
      },
      {
        "from": "user",
        "text": "میتونم با تهیه دوره سه رقمی بشم؟",
        "at": "2026-11-26T08:24:59.739Z"
      },
      {
        "from": "user",
        "text": "؟؟",
        "at": "2026-11-26T11:13:22.009Z"
      },
      {
        "from": "admin",
        "text": "وقت بخیر",
        "at": "2026-11-26T12:59:44.465Z"
      },
      {
        "from": "admin",
        "text": "درصورتی از الان شروع به دیدن آموزش دوره کنید، بله",
        "at": "2026-11-26T12:59:59.407Z"
      },
      {
        "from": "admin",
        "text": "هر سه پایه به صورت کامل توی سوپرپک تکنیکی، کاملا از زیر صفر تدریس شده",
        "at": "2026-11-26T13:00:17.579Z"
      },
      {
        "from": "user",
        "text": "به درد کنکور ۱۴۰۷ میخوره یعنی؟",
        "at": "2026-11-26T14:07:44.617Z"
      },
      {
        "from": "admin",
        "text": "بله دورهٔ مختص ۴۰۷ برای شما فعال میشه",
        "at": "2026-11-26T14:38:52.498Z"
      },
      {
        "from": "user",
        "text": "یعنی میگین دوره متناسب با هر سال کنکور اپدیت میشه برامون؟؟و برا کنکور ۴۰۷ دیگه نیاز به هیچ منبع فیلم نیست!؟",
        "at": "2026-11-26T15:00:20.279Z"
      }
    ],
    "09913246970": [
      {
        "from": "user",
        "text": "هزینه",
        "at": "2026-11-26T08:27:20.481Z"
      }
    ],
    "09925211036": [
      {
        "from": "user",
        "text": "سلام خسته نباشید",
        "at": "2026-11-26T08:38:01.655Z"
      },
      {
        "from": "user",
        "text": "من می خوام تودوره سوپر تکنیکی تون شرکت کنم فقط ی سوال داشتم ! استاد گفتن که احتیاجی ب کتاب درسی و تست ندارین.خواستم بپرسم شما جزوه و تست رو به صورت فیزیکی به ما میدین یا آنلاین هستش ؟!",
        "at": "2026-11-26T08:39:25.733Z"
      },
      {
        "from": "user",
        "text": "ممنون میشم پاسخ بدین",
        "at": "2026-11-26T08:41:05.638Z"
      },
      {
        "from": "user",
        "text": "الووو",
        "at": "2026-11-26T08:50:47.404Z"
      },
      {
        "from": "user",
        "text": "پشتیبانی تون پاسخ گو نیس؟!!!!",
        "at": "2026-11-26T08:56:58.041Z"
      },
      {
        "from": "admin",
        "text": "وقت بخیر",
        "at": "2026-11-26T12:54:11.283Z"
      },
      {
        "from": "admin",
        "text": "جزوه تکنیکی روی پنلتون در برنامه اسپات پلیر فعال میشه به همراه بانک تست تکنیکی",
        "at": "2026-11-26T12:54:35.245Z"
      },
      {
        "from": "admin",
        "text": "اگر تمایل داشتید خودتون میتوندی پرینت بگیرید ازش",
