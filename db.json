    "09013724990": [
      {
        "from": "user",
        "text": "سلام",
        "at": "2026-11-26T11:24:01.860Z"
      },
      {
        "from": "user",
        "text": "من واریزی انجام دادم چطوری و کی فعال میشه واسم؟",
